PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ethesis_platform
JWT_SECRET=ethesis-dev-secret-change-me
JWT_EXPIRES=12h
SUPERADMIN_EMAIL=superadmin@ethesis.local
SUPERADMIN_PASSWORD=Admin@123
# Public site URL for links in emails. On a hosted server this can be omitted —
# the API uses the URL the browser called (e.g. http://13.204.85.225).
# Set it only when you want a fixed domain, or for local mail tests:
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAIL_FROM=noreply@rrp.aiimsexams.ac.in
MAIL_FROM_NAME=AIIMS EXAMS
MAIL_CC=dmmchprofessionalaiims@gmail.com

# SMTP2GO HTTP API (used instead of SMTP when the key is set)
SMTP2GO_API_KEY=your-smtp2go-api-key
SMTP2GO_API_URL=https://api.smtp2go.com/v3/email/send
